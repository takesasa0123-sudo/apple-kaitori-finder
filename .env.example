# =========================================================
# iPhone 18 買取価格トラッカー 環境設定テンプレート (.env)
# このファイルをコピーして「.env」という名前に変更し、
# ご自身のトークンを入力してください。
# =========================================================

# LINE公式アカウント (Messaging API) 設定
# LINE Developers (https://developers.line.biz/) でチャネルを作成し、
# 「Messaging API」タブ最下部の「チャネルアクセストークン（長期）」を貼り付けます。
LINE_CHANNEL_ACCESS_TOKEN=ここにLINEチャネルアクセストークンを貼り付け

# 特定の個人にのみ送りたい場合はユーザーID (例: U1234567890abcdef...) を指定
# 空欄のままだと、ボットを友だち追加している全員へ一斉配信（ブロードキャスト）されます
LINE_USER_ID=

# 毎朝の通知スケジュール時刻 (24時間表記 HH:MM)
MORNING_SCHEDULE_TIME=08:00

# 等価格以上（定価以上・還元率100%以上）の端末情報のみをLINE通知するかどうか (true / false)
# true に設定すると、定価以上で売れる端末のみに絞って通知します
LINE_PROFIT_ONLY=false

# 通知対象とする最低還元率 (%) (デフォルト: 100.0)
LINE_MIN_PROFIT_RATE=100.0

# 等価格以上の端末が0件のときに通知をスキップするか (true: 送信しない / false: 0件である旨を通知)
LINE_SKIP_IF_NO_PROFIT=false

# ---------------------------------------------------------
# 指定端末フィルター設定 (特定の端末のみを取得・通知したい場合)
# 未指定(空欄)の場合は全32モデルが対象となります
# ---------------------------------------------------------
# キーワード指定 (例: "Pro Max 256GB", "バーガンディ", "MJX74J/A")
TARGET_DEVICE=
# または各項目で個別指定:
TARGET_MODEL=
TARGET_CAPACITY=
TARGET_COLOR=

# Discord 通知用 Webhook URL (任意)
DISCORD_WEBHOOK_URL=
